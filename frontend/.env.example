NEXT_PUBLIC_API_URL=http://localhost:5000/api/media

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# Leave blank for beautiful placeholder previews, or paste your Publisher ID to activate live ads
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Get from analytics.google.com > Admin > Data Streams > Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Adsterra Ad Zone Keys
# Get from publishers.adsterra.com > Websites > GET CODE
NEXT_PUBLIC_ADSTERRA_POPUNDER_URL=
NEXT_PUBLIC_ADSTERRA_BANNER_KEY_728=
NEXT_PUBLIC_ADSTERRA_BANNER_KEY_320=
